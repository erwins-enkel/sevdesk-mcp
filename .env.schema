# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Every environment variable the code reads is declared here. `varlock audit` (CI and
# pre-push) fails on an undeclared or a stale (no longer read) variable.
#
# @defaultRequired=false @defaultSensitive=false
# ----------

# Locale variables (POSIX precedence LC_ALL > LC_MESSAGES > LANG) that pick the CLI
# language; German locales get German, everything else English.
# @example="de_DE.UTF-8"
LC_ALL=

# @example="de_DE.UTF-8"
LC_MESSAGES=

# @example="de_DE.UTF-8"
LANG=

# A sevDesk API token. When set, the server runs with exactly this one profile (decision 2); for
# Docker, CI and other environments without an OS keychain. Never commit a real token.
# @sensitive
SEVDESK_API_TOKEN=

# Names the profile of SEVDESK_API_TOKEN: 1 to 32 characters a-z, 0-9 and -. Default: env.
# @example="manufare"
SEVDESK_PROFILE=

# Read-only mode for every profile (decision 3): only calls that change nothing run; writes and
# irreversible calls are rejected, never held. Any value but empty, false or 0 (case ignored) turns
# it on. A profile with "readonly": true in the config file stays read-only when this is false.
# @example="true"
SEVDESK_READONLY=

# Where the config file and the data/state directory live (decision 13). Linux and other Unix
# systems follow XDG: an empty or relative value counts as unset, and the defaults are ~/.config
# and ~/.local/state. macOS uses ~/Library/Application Support and ignores them. setup also finds
# Claude Desktop's config on Linux in XDG_CONFIG_HOME/Claude, and OpenCode's on every OS in
# XDG_CONFIG_HOME/opencode (default ~/.config/opencode); a relative value there makes setup leave
# OpenCode alone, as OpenCode would resolve it against the directory it starts in.
# @example="/home/me/.config"
XDG_CONFIG_HOME=

# @example="/home/me/.local/state"
XDG_STATE_HOME=

# Windows: the roaming folder (config) and the local folder (data/state); unset or relative falls
# back to AppData\Roaming and AppData\Local in the user profile. setup also finds Claude Desktop's
# config there (the packaged app's folder under LOCALAPPDATA, else APPDATA\Claude).
# @example="C:\Users\me\AppData\Roaming"
APPDATA=

# @example="C:\Users\me\AppData\Local"
LOCALAPPDATA=

# Claude Code's config directory (default ~/.claude). setup registers the server in the
# .claude.json there, else in ~/.claude.json. A relative value depends on the directory Claude Code
# starts in, so setup then leaves Claude Code alone.
# @example="/home/me/.claude-work"
CLAUDE_CONFIG_DIR=

# The Codex home (default ~/.codex), whose config.toml ChatGPT Desktop and the Codex CLI share.
# setup registers the server there. A relative value depends on the directory Codex starts in, so
# setup then leaves ChatGPT Desktop / Codex alone.
# @example="/home/me/.codex-work"
CODEX_HOME=

# The manual E2E run against a real sevDesk account (`bun run test:e2e`, decision 29): the API token
# of that account. Without it the run is skipped. Local only, never in CI; never commit a real token.
# @sensitive
SEVDESK_E2E_TOKEN=

# The only address the E2E mail test sends a test offer to; without it the mail test is skipped.
# A private address of the operator: it never appears in the repository.
# @sensitive
SEVDESK_E2E_MAIL_TO=
