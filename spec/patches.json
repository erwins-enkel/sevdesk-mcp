                          "description": "The countries",
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "objectName": {
                                "type": "string",
                                "example": "StaticCountry"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "401": {
                "description": "Authentication required"
              }
            },
            "security": [
              {
                "api_key": []
              }
            ]
          }
        }
      },
      {
