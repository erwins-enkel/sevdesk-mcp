  {
    "why": "Read endpoints that sevDesk's docs reference or that required fields depend on, missing from the spec: GET /StaticCountry, GET /Category and GET /SevSequence/Factory/getByType are named in the spec's own descriptions; contactPerson needs a SevUser and positions a Unity. Evidence they exist in the live API: Pipedream's sevDesk app (GET /SevUser, GET /StaticCountry), chift.eu's sevDesk integration notes (StaticCountry, SevSequence/Factory/getByType) and github.com/j-mastr/sevdesk-api (Category, SevSequence, SevUser, Unity).",
    "changes": [
      {
        "path": "/paths/~1SevUser",
        "to": {
          "get": {
            "tags": ["Basics"],
            "summary": "Retrieve users",
            "description": "Returns the users of the sevdesk account. The contactPerson of an order, invoice or credit note is one of them: { \"id\": <id>, \"objectName\": \"SevUser\" }.",
            "operationId": "getSevUsers",
            "responses": {
              "200": {
                "description": "Successful operation",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "objects": {
                          "description": "The users",
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "objectName": {
                                "type": "string",
                                "example": "SevUser"
                              },
                              "username": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "401": {
                "description": "Authentication required"
              }
            },
            "security": [
              {
                "api_key": []
              }
            ]
          }
        }
      },
      {
        "path": "/paths/~1StaticCountry",
        "to": {
          "get": {
            "tags": ["Basics"],
            "summary": "Retrieve countries",
            "description": "Returns the countries sevdesk knows. A country is referenced as { \"id\": <id>, \"objectName\": \"StaticCountry\" }, e.g. the country of a contact address or an order's addressCountry.",
            "operationId": "getStaticCountries",
            "responses": {
              "200": {
                "description": "Successful operation",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
