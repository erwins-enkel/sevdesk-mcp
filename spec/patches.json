      {
        "path": "/paths/~1SevSequence~1Factory~1getByType",
        "to": {
          "get": {
            "tags": ["Basics"],
            "summary": "Retrieve the number sequence of a document type",
            "description": "Returns the number sequence sevdesk uses for a document type: its format and the next number, e.g. for the orderNumber of a new offer (objectType=Order, type=AN) or the invoiceNumber of a new invoice (objectType=Invoice, type=RE).",
            "operationId": "getSevSequenceByType",
            "parameters": [
              {
                "name": "objectType",
                "in": "query",
                "description": "Object type, e.g. Order, Invoice or CreditNote",
                "required": true,
                "explode": true,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "type",
                "in": "query",
                "description": "Document type, e.g. AN (offer), RE (invoice) or CN (credit note)",
                "required": false,
                "explode": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "Successful operation",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "objects": {
                          "type": "object",
                          "properties": {
                            "format": {
                              "description": "Number format; %NUMBER stands for nextSequence",
                              "type": "string",
                              "example": "AN-%NUMBER"
                            },
                            "nextSequence": {
                              "description": "The next number of the sequence",
                              "type": "integer",
                              "example": 1042
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "401": {
                "description": "Authentication required"
              }
            },
            "security": [
              {
                "api_key": []
              }
            ]
          }
        }
      }
    ]
