  {
    "why": "List filters that sevDesk's docs ('How to filter for certain contacts' / '… orders' in the Contact and Order tag descriptions) document but the operations do not declare: name on GET /Contact, orderType on GET /Order.",
    "changes": [
      {
        "path": "/paths/~1Contact/get/parameters/2",
        "to": {
          "name": "name",
          "in": "query",
          "description": "Retrieve all contacts with this name as name, surename or familyname",
          "required": false,
          "explode": true,
          "schema": {
            "type": "string"
          }
        }
      },
      {
        "path": "/paths/~1Order/get/parameters/6",
        "to": {
          "name": "orderType",
          "in": "query",
          "description": "Retrieve all orders of this type: AN (estimate / proposal), AB (order confirmation), LI (delivery note)",
          "required": false,
          "explode": true,
          "schema": {
            "type": "string",
            "enum": ["AN", "AB", "LI"]
          }
        }
      }
    ]
