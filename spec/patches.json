[
  {
    "why": "The factory save bodies list a positions property that does not exist as required (e.g. saveOrder requires 'orderPos', but its positions property is 'orderPosSave'). Evidence: the spec's own properties.",
    "changes": [
      {
        "path": "/components/schemas/saveOrder/required",
        "from": ["order", "orderPos"],
        "to": ["order", "orderPosSave"]
      },
      {
        "path": "/components/schemas/saveInvoice/required",
        "from": ["invoice", "invoicePos"],
        "to": ["invoice", "invoicePosSave"]
      },
      {
        "path": "/components/schemas/saveVoucher/required",
        "from": ["voucher", "voucherPos"],
        "to": ["voucher", "voucherPosSave"]
      },
      {
        "path": "/components/schemas/saveCreditNote/required",
        "from": ["creditNote", "creditNotePos"],
        "to": ["creditNote", "creditNotePosSave"]
      }
    ]
  },
