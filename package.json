{
  "name": "@erwins-enkel/sevdesk-mcp",
  "version": "0.0.0",
  "description": "The whole sevdesk API in two MCP tools for Claude, ChatGPT & co. (Code Mode). Local and open source. Not developed or endorsed by sevdesk.",
  "keywords": [
    "sevdesk",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "codex",
    "opencode",
    "ai",
    "llm",
    "code-mode",
    "accounting",
    "bookkeeping",
    "invoicing",
    "buchhaltung",
    "rechnungen",
    "angebote"
  ],
  "homepage": "https://github.com/erwins-enkel/sevdesk-mcp#readme",
  "bugs": {
    "url": "https://github.com/erwins-enkel/sevdesk-mcp/issues"
  },
  "license": "MIT",
  "author": "Kai Osthoff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwins-enkel/sevdesk-mcp.git"
  },
  "type": "module",
  "bin": {
    "sevdesk-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "eslint": "10.15.0",
    "fallow": "3.43.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "varlock": "1.25.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.2",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "entities": "9.0.0",
    "jsonc-parser": "3.3.1",
    "quickjs-emscripten-core": "0.32.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:docs": "node scripts/check-docs.ts",
    "update-spec": "node scripts/update-spec.ts",
    "prepare": "husky",
    "audit:dead": "fallow",
    "audit:env": "varlock audit",
    "lint:actions": "bash scripts/actionlint.sh",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:i18n && bun run check:docs && bun run audit:dead && bun run audit:env && bun run lint:actions"
  }
}
